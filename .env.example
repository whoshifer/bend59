# Локальная разработка: скопируйте в .env и замените все значения.
POSTGRES_DB=bend
POSTGRES_USER=bend
POSTGRES_PASSWORD=change_this_local_database_password
DATABASE_URL=postgresql://bend:***@localhost:5433/bend

# Не менее 32 случайных символов. Не публикуйте значение.
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Создаётся только при первом запуске seed.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change_this_first_admin_password

SITE_URL=http://localhost:3001

# --- Уведомления о заявках (оба канала опциональны) ---
# Telegram: создайте бота у @BotFather, получите токен; chat_id — через @userinfobot
# или напишите боту и откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# E-mail через SMTP (например, mail.ru: smtp.mail.ru, порт 465)
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=bend@example.ru
# SMTP_PASS=password_for_mail_app
# NOTIFY_EMAIL_TO=recipient@example.ru
