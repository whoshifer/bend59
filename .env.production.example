# Скопируйте этот файл в .env на VDS и замените все значения.
# Не загружайте .env в Git, архив для передачи или публичное хранилище.

SITE_DOMAIN=example.ru
SITE_URL=https://example.ru

POSTGRES_DB=bend
POSTGRES_USER=bend
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password

# Не менее 32 случайных символов.
AUTH_SECRET=replace_with_a_long_unique_random_secret

# Создаётся только при первом запуске пустой базы; затем смените пароль через процедуру администрирования.
ADMIN_EMAIL=owner@example.ru
ADMIN_PASSWORD=replace_with_a_strong_first_admin_password
